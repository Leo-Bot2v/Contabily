# ============================================
# CONFIGURACIÓN PARA TESTING - Contabily
# ============================================
# Usa este archivo para tests automatizados y Docker

# --------------------------------------------
# APP
# --------------------------------------------
NODE_ENV=test
PORT=3001
API_PREFIX=api/v1

# --------------------------------------------
# BASE DE DATOS - TESTING (PostgreSQL Docker puerto 5433)
# --------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=contabily_test
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --------------------------------------------
# JWT (Valores fijos para tests consistentes)
# --------------------------------------------
JWT_SECRET=test-secret-key-for-testing-only-32chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=test-refresh-secret-key-for-testing-32chars
JWT_REFRESH_EXPIRES_IN=1d

# --------------------------------------------
# GOOGLE OAUTH (Mock para testing)
# --------------------------------------------
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# --------------------------------------------
# FRONTEND URL
# --------------------------------------------
FRONTEND_URL=http://localhost:5173