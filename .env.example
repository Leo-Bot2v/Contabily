# ============================================
# CONFIGURACIÓN DE ENTORNO - Contabily
# ============================================
# Copia este archivo a .env y .env.test según tu entorno

# --------------------------------------------
# APP
# --------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# --------------------------------------------
# BASE DE DATOS - PRODUCCIÓN (Supabase)
# --------------------------------------------
# Descomenta y configura cuando tengas Supabase listo
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_ANON_KEY=tu-anon-key
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --------------------------------------------
# BASE DE DATOS - TESTING/DESARROLLO (PostgreSQL Local/Docker)
# --------------------------------------------
# Puerto 5433 para Docker (colaborador), 5432 para local
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=contabily_test
DB_SYNCHRONIZE=true
DB_LOGGING=true

# --------------------------------------------
# JWT
# --------------------------------------------
JWT_SECRET=tu-super-secreto-jwt-cambia-en-produccion-min-32-chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=tu-refresh-secreto-diferente-al-de-arriba
JWT_REFRESH_EXPIRES_IN=7d

# --------------------------------------------
# GOOGLE OAUTH (Supabase maneja esto en producción)
# --------------------------------------------
# Para testing local sin Supabase, configura estas credenciales en Google Cloud Console
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# --------------------------------------------
# FRONTEND URL (para CORS y redirects)
# --------------------------------------------
FRONTEND_URL=http://localhost:5173